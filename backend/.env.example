# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql+asyncpg://CHANGE_USER:CHANGE_PASS@postgres:5432/alerts
REDIS_URL=redis://redis:6379/0
JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX
JWT_ALG=HS256
JWT_TTL_MIN=10080

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=alerts_session

FCM_CREDENTIALS_FILE=/app/secrets/firebase.json

RSS_POLL_SECONDS=45
